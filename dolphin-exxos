#!/bin/bash
# Launch the patched (Exxos/Win7 tile view) Dolphin.
#
# The packaged /usr/bin/dolphin is deliberately NOT replaced: apt would
# overwrite it on the next update, and a broken system file manager is a bad
# failure mode. This runs the locally built binary instead, so the stock one
# stays intact as a fallback.
#
# On MX 21 this also had to put the staged toolchain on LD_LIBRARY_PATH,
# because Qt5/KF5 -dev packages could not be installed there. MX 23 can install
# them, so the build links against the system libraries and no override is
# wanted -- forcing one now would risk mixing library versions.
HERE="$(cd "$(dirname "$0")" && pwd)"
BIN="$HERE/build/bin/dolphin"

if [ ! -x "$BIN" ]; then
    echo "Exxos Dolphin is not built: $BIN" >&2
    echo "Falling back to the system file manager." >&2
    exec /usr/bin/dolphin "$@"
fi

# ---------------------------------------------------------------------------
# The computer:/ worker, kept current with NO root and no terminal step.
#
# KIO spawns a worker as `kioslave5 <absolute path to the .so> computer ...`,
# and the path is resolved through the Qt plugin path of the process that
# spawns it. Setting QT_PLUGIN_PATH here is therefore enough for our Dolphin to
# load a worker out of the user's own home -- verified: the spawned process ran
#
#   /home/chris/.local/lib/qt5/plugins/kf5/kio/computer.so
#
# So the root-owned copy under /usr/lib is no longer needed for this build. It
# is left alone (install.sh still maintains it) only so that OTHER
# applications' computer:/ listings match; nothing here depends on it.
#
# Three sessions were spent testing device behaviour against a worker that was
# out of date, because updating it needed a password and a terminal. Now the
# build is copied into place on every start and the mismatch cannot happen.
# ---------------------------------------------------------------------------
WORKER_SRC="$HERE/../kio-computer/computer.so"
WORKER_DIR="$HOME/.local/lib/qt5/plugins/kf5/kio"
WORKER_DST="$WORKER_DIR/computer.so"

if [ -f "$WORKER_SRC" ]; then
    mkdir -p "$WORKER_DIR"
    if ! cmp -s "$WORKER_SRC" "$WORKER_DST"; then
        cp -f "$WORKER_SRC" "$WORKER_DST.new" && mv -f "$WORKER_DST.new" "$WORKER_DST"
    fi
    # The .protocol file is what makes computer:/ a known scheme at all.
    if [ -f "$HERE/../kio-computer/computer.protocol" ]; then
        mkdir -p "$HOME/.local/share/kservices5"
        cmp -s "$HERE/../kio-computer/computer.protocol" \
               "$HOME/.local/share/kservices5/computer.protocol" || {
            cp -f "$HERE/../kio-computer/computer.protocol" \
                  "$HOME/.local/share/kservices5/computer.protocol"
            kbuildsycoca5 --noincremental >/dev/null 2>&1
        }
    fi

    # A worker started BEFORE the current .so was written is running the old
    # code from memory, and KIO keeps idle workers around to hand to the next
    # client -- so replacing the file is not enough on its own. Anything older
    # than the plugin is retired; a live one just respawns on the next request.
    if [ -f "$WORKER_DST" ]; then
        so_time=$(stat -c %Y "$WORKER_DST" 2>/dev/null || echo 0)
        for pid in $(pgrep -x kioslave5 2>/dev/null); do
            case "$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null)" in
                *computer.so*)
                    started=$(stat -c %Y "/proc/$pid" 2>/dev/null || echo 0)
                    [ "$started" -lt "$so_time" ] && kill "$pid" 2>/dev/null
                    ;;
            esac
        done
    fi

    QT_PLUGIN_PATH="$HOME/.local/lib/qt5/plugins${QT_PLUGIN_PATH:+:$QT_PLUGIN_PATH}"
    export QT_PLUGIN_PATH
fi

exec "$BIN" "$@"
