#!/bin/bash
# Launch the patched (Exxos/Win7 tile view) Dolphin.
#
# The packaged /usr/bin/dolphin is deliberately NOT replaced: apt would
# overwrite it on the next update, and a broken system file manager is a bad
# failure mode. This runs the locally built binary instead, so the stock one
# stays intact as a fallback.
#
# On MX 21 this also had to put the staged toolchain on LD_LIBRARY_PATH,
# because Qt5/KF5 -dev packages could not be installed there. MX 23 can install
# them, so the build links against the system libraries and no override is
# wanted -- forcing one now would risk mixing library versions.
HERE="$(cd "$(dirname "$0")" && pwd)"
BIN="$HERE/build/bin/dolphin"

if [ ! -x "$BIN" ]; then
    echo "Exxos Dolphin is not built: $BIN" >&2
    echo "Falling back to the system file manager." >&2
    exec /usr/bin/dolphin "$@"
fi

# ---------------------------------------------------------------------------
# The computer:/ worker, kept current with NO root and no terminal step.
#
# KIO spawns a worker as `kioslave5 <absolute path to the .so> computer ...`,
# and the path is resolved through the Qt plugin path of the process that
# spawns it. Setting QT_PLUGIN_PATH here is therefore enough for our Dolphin to
# load a worker out of the user's own home.
#
# So the root-owned copy under /usr/lib is no longer needed for this build. It
# is left alone (install.sh still maintains it) only so that OTHER
# applications' computer:/ listings match; nothing here depends on it.
#
# Three sessions were spent testing device behaviour against a worker that was
# out of date, because updating it needed a password and a terminal. Now the
# build is copied into place on every start and the mismatch cannot happen.
# ---------------------------------------------------------------------------
WORKER_SRC="$HERE/../kio-computer/computer.so"
WORKER_DIR="$HOME/.local/lib/qt5/plugins/kf5/kio"
WORKER_DST="$WORKER_DIR/computer.so"

if [ -f "$WORKER_SRC" ]; then
    mkdir -p "$WORKER_DIR"
    if ! cmp -s "$WORKER_SRC" "$WORKER_DST"; then
        cp -f "$WORKER_SRC" "$WORKER_DST.new" && mv -f "$WORKER_DST.new" "$WORKER_DST"
    fi
    # The .protocol file is what makes computer:/ a known scheme at all.
    if [ -f "$HERE/../kio-computer/computer.protocol" ]; then
        mkdir -p "$HOME/.local/share/kservices5"
        cmp -s "$HERE/../kio-computer/computer.protocol" \
               "$HOME/.local/share/kservices5/computer.protocol" || {
            cp -f "$HERE/../kio-computer/computer.protocol" \
                  "$HOME/.local/share/kservices5/computer.protocol"
            kbuildsycoca5 --noincremental >/dev/null 2>&1
        }
    fi

    # A worker started BEFORE the current .so was written is running the old
    # code from memory, and KIO keeps idle workers around to hand to the next
    # client -- so replacing the file is not enough on its own. Anything older
    # than the plugin is retired; a live one just respawns on the next request.
    if [ -f "$WORKER_DST" ]; then
        so_time=$(stat -c %Y "$WORKER_DST" 2>/dev/null || echo 0)
        for pid in $(pgrep -x kioslave5 2>/dev/null); do
            case "$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null)" in
                *computer.so*)
                    started=$(stat -c %Y "/proc/$pid" 2>/dev/null || echo 0)
                    [ "$started" -lt "$so_time" ] && kill "$pid" 2>/dev/null
                    ;;
            esac
        done
    fi

    QT_PLUGIN_PATH="$HOME/.local/lib/qt5/plugins${QT_PLUGIN_PATH:+:$QT_PLUGIN_PATH}"
    export QT_PLUGIN_PATH
fi

# ---------------------------------------------------------------------------
# Media-change polling for removable drives.
#
# The one piece that genuinely needs root, and only once. Without it a floppy
# or card swap is invisible to the whole desktop: udisks is never told, because
# nothing polls the drive. udisks Block.Rescan was measured to make no
# difference at all -- see system-tools/61-exxos-removable-polling.rules.
#
# Asked once, with a graphical password prompt, and remembered either way.
# EXXOS_SKIP_POLL_CHECK=1 skips it.
# ---------------------------------------------------------------------------
POLL_RULE=/etc/udev/rules.d/61-exxos-removable-polling.rules
POLL_ASKED="$HOME/.config/exxos-media-polling-declined"

SHIPPED_RULE="$HERE/../system-tools/61-exxos-removable-polling.rules"
# Offer when the rule is missing OR when the shipped one has CHANGED. The
# poll interval has already been retuned once -- a floppy seeks to answer
# the kernel's check, and every two seconds was audible -- and an
# out-of-date copy would quietly keep the old behaviour.
if [ -z "$EXXOS_SKIP_POLL_CHECK" ] && [ -f "$SHIPPED_RULE" ] \
   && ! cmp -s "$SHIPPED_RULE" "$POLL_RULE" && [ ! -f "$POLL_ASKED" ] \
   && [ -x "$HERE/../system-tools/install-media-polling.sh" ]; then
    unpolled=""
    for d in /sys/block/sd[a-z] /sys/block/mmcblk[0-9]; do
        [ -e "$d" ] || continue
        [ "$(cat "$d/removable" 2>/dev/null)" = "1" ] || continue
        case "$(cat "$d/events_poll_msecs" 2>/dev/null)" in
            -1|"") unpolled="$unpolled $(basename "$d")" ;;
        esac
    done
    # An existing rule with a different interval also wants offering.
    [ -f "$POLL_RULE" ] && unpolled="${unpolled:- (interval changed)}"
    # In the BACKGROUND: kdialog blocks until it is answered, and Dolphin must
    # not wait on a question nobody is at the machine to read.
    if [ -n "$unpolled" ] && command -v kdialog >/dev/null; then
      (
        if kdialog --title "Dolphin Exxos Edition" --yesno \
"These removable drives are not checked for media changes:
$unpolled

A disk or card put into one of them will not be noticed until something
else happens - the drive never announces it, and nothing is asking.
The CD/DVD drive works only because it IS asked.

The check runs every 5 seconds. A floppy drive moves its head to answer,
so if the clicking bothers you, run this afterwards with a larger number:
  sudo system-tools/install-media-polling.sh --interval 15000

This installs one udev rule so the kernel checks them too. It asks the
drive whether the medium changed; it does not read the disk, so an idle
drive is not made to spin.

Administrator access is needed, once. Set it up now?" 2>/dev/null; then
            pkexec "$HERE/../system-tools/install-media-polling.sh" \
                > "${TMPDIR:-/tmp}/exxos-media-poll.log" 2>&1 \
                && kdialog --title "Dolphin Exxos Edition" --msgbox \
                   "Removable drives are now checked for media changes.

$(cat "${TMPDIR:-/tmp}/exxos-media-poll.log")" 2>/dev/null &
        else
            : > "$POLL_ASKED"      # asked, declined: do not nag again
        fi
      ) >/dev/null 2>&1 &
    fi
fi

exec "$BIN" "$@"
