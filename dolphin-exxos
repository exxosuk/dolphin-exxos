#!/bin/bash
# Launch the patched (Exxos/Win7 tile view) Dolphin.
#
# The packaged /usr/bin/dolphin is deliberately NOT replaced: apt would
# overwrite it on the next update, and a broken system file manager is a bad
# failure mode. This runs the locally built binary instead, so the stock one
# stays intact as a fallback.
#
# On MX 21 this also had to put the staged toolchain on LD_LIBRARY_PATH,
# because Qt5/KF5 -dev packages could not be installed there. MX 23 can install
# them, so the build links against the system libraries and no override is
# wanted -- forcing one now would risk mixing library versions.
HERE="$(cd "$(dirname "$0")" && pwd)"
BIN="$HERE/build/bin/dolphin"

if [ ! -x "$BIN" ]; then
    echo "Exxos Dolphin is not built: $BIN" >&2
    echo "Falling back to the system file manager." >&2
    exec /usr/bin/dolphin "$@"
fi

# ---------------------------------------------------------------------------
# The computer:/ worker has to match the binary.
#
# It lives in a root-owned plugin directory, so it cannot be updated by the
# same build step that produces Dolphin, and three separate sessions have now
# been spent testing device behaviour against a worker that was months out of
# date -- every result read as "the fix did not work". The build and the
# installed plugin are compared here, and the user is asked once, rather than
# leaving a silent mismatch that looks exactly like a bug.
#
# Declining is fine: Dolphin starts either way, just with the old worker.
# EXXOS_SKIP_WORKER_CHECK=1 skips this entirely.
# ---------------------------------------------------------------------------
WORKER_SRC="$HERE/../kio-computer/computer.so"
WORKER_DST=/usr/lib/x86_64-linux-gnu/qt5/plugins/kf5/kio/computer.so

if [ -z "$EXXOS_SKIP_WORKER_CHECK" ] && [ -f "$WORKER_SRC" ] \
   && ! cmp -s "$WORKER_SRC" "$WORKER_DST"; then
    MSG="The computer:/ drive worker is out of date.

Built:     $(date -r "$WORKER_SRC" '+%d %b %H:%M')
Installed: $([ -f "$WORKER_DST" ] && date -r "$WORKER_DST" '+%d %b %H:%M' || echo 'not installed')

Drive detection - discs, cards and removable media appearing and
disappearing - will behave as it did in the older version until this
is updated. Administrator access is needed to replace it.

Update it now?"
    if command -v kdialog >/dev/null \
       && kdialog --title "Dolphin Exxos Edition" --yesno "$MSG" 2>/dev/null; then
        if pkexec /usr/bin/install -m 644 -o root -g root "$WORKER_SRC" "$WORKER_DST"; then
            # A worker already running holds the OLD code in memory and is
            # reused from the pool for minutes, so replacing the file is not
            # enough on its own.
            pkill -x kioslave5 2>/dev/null
            kbuildsycoca5 --noincremental >/dev/null 2>&1
            kdialog --title "Dolphin Exxos Edition" \
                    --passivepopup "Drive worker updated." 5 2>/dev/null &
        else
            kdialog --title "Dolphin Exxos Edition" \
                    --error "The drive worker could not be updated.

Run this in a terminal instead:
  sudo $HERE/../kio-computer/install.sh" 2>/dev/null &
        fi
    else
        echo "computer:/ worker is stale; run: sudo $HERE/../kio-computer/install.sh" >&2
    fi
fi

exec "$BIN" "$@"
