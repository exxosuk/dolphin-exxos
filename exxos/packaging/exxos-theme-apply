#!/bin/bash
# Apply the Windows 7 look to the CURRENT user's Plasma session.
#
#   exxos-theme-apply           apply
#   exxos-theme-apply --undo    put Breeze back
#
# Why this is a separate command rather than part of installing the package: a
# theme lives in each user's own configuration, and a package installs once for
# everybody as root. Writing into someone's ~/.config from a postinst is how
# packages break other people's desktops.
#
# Settings are written KEY BY KEY with kwriteconfig5, never by copying whole
# config files over the top. Copying kdeglobals or kwinrc wholesale would
# silently wipe everything else that is configured -- fonts, shortcuts, monitor
# layout, panels -- and the user would have no idea what had gone.
set -e
SRC=/usr/share/exxos
[ -d "$SRC" ] || { echo "Theme files are missing: $SRC" >&2; exit 1; }
[ "$(id -u)" != 0 ] || { echo "Run me as your normal user, NOT with sudo." >&2; exit 1; }

undo() {
    kwriteconfig5 --file kdeglobals --group General --key ColorScheme BreezeLight
    kwriteconfig5 --file kdeglobals --group Icons --key Theme breeze
    kwriteconfig5 --file kdeglobals --group KDE --key widgetStyle Breeze
    kwriteconfig5 --file kdeglobals --group KDE --key LookAndFeelPackage org.kde.breeze.desktop
    kwriteconfig5 --file plasmarc  --group Theme  --key name default
    kwriteconfig5 --file kwinrc    --group org.kde.kdecoration2 --key library org.kde.breeze
    kwriteconfig5 --file kwinrc    --group org.kde.kdecoration2 --key theme ""
    kwriteconfig5 --file kwinrc    --group org.kde.kdecoration2 --key ButtonsOnLeft MS
    kwriteconfig5 --file kwinrc    --group org.kde.kdecoration2 --key ButtonsOnRight HIAX
    kwriteconfig5 --file kwinrc    --group Plugins --key blurEnabled false
    kwriteconfig5 --file kwinrc    --group Plugins --key diminactiveEnabled --delete
    kwriteconfig5 --file kwinrc    --group Windows --key Placement --delete
    # remove plasmoid overrides
    rm -rf "$HOME/.local/share/plasma/plasmoids/org.kde.plasma.icon" \
           "$HOME/.local/share/plasma/plasmoids/org.kde.plasma.showdesktop" \
           "$HOME/.local/share/plasma/plasmoids/org.kde.plasma.kicker" \
           "$HOME/.local/share/plasma/plasmoids/org.kde.plasma.taskmanager" 2>/dev/null
    rm -f "$HOME/.config/autostart/exxos-plasmoid-check.desktop" 2>/dev/null
    rm -f "$HOME/.cache/plasma-svgelements"* "$HOME/.cache/plasma_theme_"*.kcache 2>/dev/null
    echo "Breeze restored. Log out and back in."
    exit 0
}
[ "$1" = "--undo" ] && undo

echo "Copying theme files into your home..."
for d in plasma/look-and-feel plasma/desktoptheme aurorae/themes color-schemes; do
    [ -d "$SRC/$d" ] || continue
    mkdir -p "$HOME/.local/share/$d"
    if ! cp -a "$SRC/$d/." "$HOME/.local/share/$d/" 2>/tmp/exxos-copy-err.$$; then
        echo
        echo "  ! Could not read some theme files:" >&2
        sed 's/^/    /' /tmp/exxos-copy-err.$$ >&2
        rm -f /tmp/exxos-copy-err.$$
        echo "    That is a fault in the package, not in your machine." >&2
        echo "    Report it, or work around it with:" >&2
        echo "      sudo chmod -R a+rX $SRC" >&2
        exit 1
    fi
    rm -f /tmp/exxos-copy-err.$$
    echo "  + $d"
done

echo "Applying settings..."

# NOTHING is done here about panel visibility, and that is deliberate.
#
# Dolphin shows the places panel by default, so a fresh install already has it.
# It only disappears if somebody switches it off (F9, "Show Panels"), and that
# choice is theirs to keep.

# --- colour scheme and plasma style ---
kwriteconfig5 --file kdeglobals --group General --key ColorScheme Exxos
kwriteconfig5 --file plasmarc   --group Theme   --key name Se7enAeroStyle

# --- widget style (plastique, not cde -- cde lacks menu hover highlight) ---
kwriteconfig5 --file kdeglobals --group KDE --key widgetStyle plastique

# --- window decoration: Aurorae exposeair with Win7 button layout ---
kwriteconfig5 --file kwinrc --group org.kde.kdecoration2 --key library org.kde.kwin.aurorae
kwriteconfig5 --file kwinrc --group org.kde.kdecoration2 --key theme __aurorae__svg__exposeair
kwriteconfig5 --file kwinrc --group org.kde.kdecoration2 --key ButtonsOnLeft ""
kwriteconfig5 --file kwinrc --group org.kde.kdecoration2 --key ButtonsOnRight IAX

# --- compositor: blur on, dim-inactive off (Win7 does not dim) ---
kwriteconfig5 --file kwinrc --group Plugins --key blurEnabled true
kwriteconfig5 --file kwinrc --group Plugins --key diminactiveEnabled false

# --- window placement: centred, not Smart (which drifts left) ---
kwriteconfig5 --file kwinrc --group Windows --key Placement Centered

# --- mark this as the active Global Theme ---
kwriteconfig5 --file kdeglobals --group KDE --key LookAndFeelPackage com.exxos.win7

# --- icon theme ---
ICON_NAME=Win7-plasma5up-scalable-icontheme-blackysgate.de
if [ -d "/usr/share/icons/$ICON_NAME" ] || [ -d "$HOME/.local/share/icons/$ICON_NAME" ]; then
    kwriteconfig5 --file kdeglobals --group Icons --key Theme "$ICON_NAME"
    echo "  + icon theme found and selected"
else
    echo
    echo "  ! The icon theme is not installed, so icons will stay Breeze."
    echo "    Install it with:  sudo apt install exxos-icons"
fi

# --- plasmoid patches (start menu, quick-launch spacing, taskbar layout) ---
PATCH_DIR="$SRC/plasma/look-and-feel/com.exxos.win7/bundle/plasmoid-patches"
if [ -f "$PATCH_DIR/rebuild-overrides.sh" ]; then
    echo
    echo "Applying panel widget patches..."
    if bash "$PATCH_DIR/rebuild-overrides.sh"; then
        echo "  + panel patches applied"
    else
        echo "  ! Some patches did not apply -- those widgets keep stock behaviour."
        echo "    See: $PATCH_DIR/README.md"
    fi

    # set up login-time check so patches are rebuilt after Plasma upgrades
    mkdir -p "$HOME/.config/autostart"
    cat > "$HOME/.config/autostart/exxos-plasmoid-check.desktop" <<AUTOSTART
[Desktop Entry]
Type=Application
Name=Exxos panel widget check
Comment=Rebuild the Exxos plasmoid overrides if Plasma has been upgraded
Exec=$PATCH_DIR/check-on-login.sh
Terminal=false
X-KDE-autostart-phase=2
NoDisplay=true
AUTOSTART
    echo "  + login check installed (auto-rebuilds after Plasma upgrades)"
else
    echo
    echo "  ! Plasmoid patches not found at $PATCH_DIR"
    echo "    Start menu and quick-launch spacing will stay stock."
fi

# --- clear Plasma theme caches so the new theme renders immediately ---
rm -f "$HOME/.cache/plasma-svgelements"* "$HOME/.cache/plasma_theme_"*.kcache "$HOME/.cache/icon-cache.kcache" 2>/dev/null

echo
echo "Done. Log out and back in for the full effect."
echo "Undo with: exxos-theme-apply --undo"
