+    // --- LOCAL OVERRIDE (theme work 2026-08-30) ---------------------------
+    // Match menu7.PNG: the Windows Classic Start Menu is FLAT and OPAQUE,
+    // sampled at (244,244,247) across 88-97% of its area - no glass at all.
+    // The Plasma theme's dialogs/background.svg is shared by every Plasma
+    // popup AND the panel shares its colour group, so recolouring the theme
+    // made panel text dark-on-dark. Painting the backdrop here instead keeps
+    // the change contained to this menu.
+    // Revert: rm -rf ~/.local/share/plasma/plasmoids/org.kde.plasma.kicker
+    Rectangle {
+        id: win7Backdrop
+        anchors.fill: parent
+        anchors.margins: -units.smallSpacing
+        color: "#f4f4f7"
+        border.color: "#9a9a9a"
+        border.width: 1
+        z: -1
+    }
+
     Row {
         id: mainRow
 
@@ -298,6 +316,23 @@
     PlasmaExtras.SearchField {
         id: searchField
 
+        // --- EXXOS LOCAL OVERRIDE ------------------------------------------
+        // The field inherited the Plasma theme's dark colours, so on the light
+        // menu backdrop it was dark-grey text on a mid-grey field with an
+        // almost invisible placeholder.
+        //
+        // A child Rectangle at z:-1 does NOT work: SearchField draws its own
+        // background item, which sits above anything added as a child. The
+        // background PROPERTY has to be replaced instead.
+        background: Rectangle {
+            color: "#fbfbfb"
+            border.color: "#9a9a9a"
+            border.width: 1
+            radius: 2
+        }
+        color: "#1a1a1a"
+        placeholderTextColor: "#1a1a1a"
+
         anchors.bottom: mainRow.bottom
         anchors.left: parent.left
         anchors.leftMargin: sideBar.width + (sideBar.width ? mainRow.spacing : PlasmaCore.Units.smallSpacing)
